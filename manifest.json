{
  "manifest_version": 3,
  "name": "Reelax 助手",
  "version": "1.7.3",
  "description": "浏览器启动时自动打开 reelax.cn，并向该站点注入可配置的 JS 脚本（如自动补满次数）。Chrome MV3 版本。",
  "homepage_url": "https://reelax.cn/",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "downloads",
    "scripting",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "*://reelax.cn/*",
    "*://static.cloudflareinsights.com/*",
    "https://open.feishu.cn/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background-boot.js"
  },
  "action": {
    "default_title": "Reelax 助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://reelax.cn/*"],
      "js": ["scripts/sync-hook.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["*://reelax.cn/*"],
      "js": ["chrome-polyfill.js", "injector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["scripts/*"],
      "matches": ["*://reelax.cn/*"]
    }
  ]
}